    <dashboard name="2 Network">
      <style/>
      <size maxheight="820" maxwidth="1300" minheight="820" minwidth="1300"/>
      <datasources>
        <datasource name="Parameters"/>
      </datasources>
      <datasource-dependencies datasource="Parameters">
        <column caption="Rank people by" datatype="string" name="[Parameter 1]" param-domain-type="list" role="measure" type="nominal" value="&quot;Betweenness&quot;">
          <calculation class="tableau" formula="&quot;Betweenness&quot;"/>
          <members>
            <member value="&quot;Betweenness&quot;"/>
            <member value="&quot;PageRank&quot;"/>
            <member value="&quot;Contacts&quot;"/>
            <member value="&quot;Emails sent&quot;"/>
          </members>
        </column>
        <column caption="Ties shown" datatype="string" name="[Parameter 4]" param-domain-type="list" role="measure" type="nominal" value="&quot;Strong ties only&quot;">
          <calculation class="tableau" formula="&quot;Strong ties only&quot;"/>
          <members>
            <member value="&quot;Strong ties only&quot;"/>
            <member value="&quot;All ties&quot;"/>
          </members>
        </column>
        <column caption="Community" datatype="string" name="[Parameter 5]" param-domain-type="list" role="measure" type="nominal" value="&quot;All communities&quot;">
          <calculation class="tableau" formula="&quot;All communities&quot;"/>
          <members>
            <member value="&quot;All communities&quot;"/>
            <member value="&quot;C1 Leadership core&quot;"/>
            <member value="&quot;C2 Staff cluster around DIR-01&quot;"/>
            <member value="&quot;C3 Trading &amp; logistics desk&quot;"/>
            <member value="&quot;C4 Real-time trading desk&quot;"/>
            <member value="&quot;C5 Gas pipeline &amp; regulatory&quot;"/>
            <member value="&quot;C6 Trading &amp; logistics desk (TRD-02)&quot;"/>
            <member value="&quot;C7 Staff cluster around UNK-12&quot;"/>
          </members>
        </column>
      </datasource-dependencies>
      <zones>
