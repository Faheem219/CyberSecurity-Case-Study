                <member value="&quot;C3 Trading &amp; logistics desk&quot;"/>
                <member value="&quot;C4 Real-time trading desk&quot;"/>
                <member value="&quot;C5 Gas pipeline &amp; regulatory&quot;"/>
                <member value="&quot;C6 Trading &amp; logistics desk (TRD-02)&quot;"/>
                <member value="&quot;C7 Staff cluster around UNK-12&quot;"/>
