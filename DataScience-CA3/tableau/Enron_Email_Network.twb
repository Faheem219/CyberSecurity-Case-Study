      <aliases enabled="yes"/>
      <column caption="Rank people by" datatype="string" name="[Parameter 1]" param-domain-type="list" role="measure" type="nominal" value="&quot;Betweenness&quot;">
        <calculation class="tableau" formula="&quot;Betweenness&quot;"/>
        <members>
          <member value="&quot;Betweenness&quot;"/>
          <member value="&quot;PageRank&quot;"/>
          <member value="&quot;Contacts&quot;"/>
