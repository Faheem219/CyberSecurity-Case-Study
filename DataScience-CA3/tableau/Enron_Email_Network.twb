      <column caption="Recipients in message" datatype="integer" name="[n_recipients]" role="measure" type="quantitative"/>
      <column caption="Period" datatype="string" name="[period]" role="dimension" type="nominal"/>
      <column caption="Direction (by seniority)" datatype="string" name="[direction]" role="dimension" type="nominal"/>
      <column caption="Community link" datatype="string" name="[community_link]" role="dimension" type="nominal"/>
      <column caption="Deliveries" datatype="integer" default-format="n#,##0" name="[Calculation_1000000000000000001]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1"/>
      </column>
      <column caption="Cross-community share" datatype="real" default-format="p0.0%" name="[Calculation_1000000000000000002]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [community_link] = &quot;Across communities&quot; THEN 1 ELSE 0 END) / SUM([Calculation_1000000000000000001])"/>
      </column>
      <column caption="Keep row (period, role)" datatype="string" name="[Calculation_1000000000000000003]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ([Parameters].[Parameter 2] = &quot;All periods&quot; OR [period] = [Parameters].[Parameter 2]) AND ([Parameters].[Parameter 3] = &quot;All roles&quot; OR [sender_role] = [Parameters].[Parameter 3]) THEN &quot;Keep&quot; ELSE &quot;Drop&quot; END"/>
      </column>
      <_.fcp.ObjectModelTableType.true...column caption="deliveries" datatype="table" name="[__tableau_internal_object_id__].[deliveries.csv_6FC31B6B9CD717CC0DCB81152308F8AF]" role="measure" type="quantitative"/>
      <column-instance column="[period]" derivation="None" name="[none:period:nk]" pivot="key" type="nominal"/>
