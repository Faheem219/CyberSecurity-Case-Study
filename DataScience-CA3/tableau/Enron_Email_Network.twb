      <column caption="Selected metric" datatype="real" name="[Calculation_2000000000000000001]" role="measure" type="quantitative">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 1] WHEN &quot;Betweenness&quot; THEN [betweenness] WHEN &quot;PageRank&quot; THEN [pagerank] WHEN &quot;Contacts&quot; THEN [contacts] WHEN &quot;Emails sent&quot; THEN [emails_sent] END"/>
      </column>
      <column caption="Selected rank" datatype="integer" name="[Calculation_2000000000000000002]" role="measure" type="quantitative">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 1] WHEN &quot;Betweenness&quot; THEN [rank_betweenness] WHEN &quot;PageRank&quot; THEN [rank_pagerank] WHEN &quot;Contacts&quot; THEN [rank_contacts] WHEN &quot;Emails sent&quot; THEN [rank_emails_sent] END"/>
      </column>
      <column caption="Rank" datatype="string" name="[Calculation_2000000000000000003]" role="dimension" type="nominal">
