      <column caption="Betweenness centrality" datatype="real" name="[betweenness]" role="measure" type="quantitative"/>
      <column caption="Contacts (degree)" datatype="integer" name="[contacts]" role="measure" type="quantitative"/>
      <column caption="x (people layer)" datatype="real" name="[Calculation_3000000000000000001]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[x]"/>
      </column>
      <column caption="Keep row (ties, community)" datatype="string" name="[Calculation_3000000000000000002]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ([row_type] = &quot;Person&quot; OR [Parameters].[Parameter 4] = &quot;All ties&quot; OR [tie_type] = &quot;Strong (two-way)&quot;) AND ([Parameters].[Parameter 5] = &quot;All communities&quot; OR [community] = [Parameters].[Parameter 5]) THEN &quot;Keep&quot; ELSE &quot;Drop&quot; END"/>
      </column>
